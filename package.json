{
  "name": "be-dispatching",
  "version": "0.0.5",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements"
  ],
  "description": "Dispatch event from enhanced element with specified name.",
  "main": "be-dispatching.js",
  "module": "be-dispatching.js",
  "dependencies": {
    "assign-gingerly": "0.0.97",
    "be-hive": "0.1.18",
    "mount-observer": "0.1.53",
    "roundabout-lib": "0.0.38",
    "nested-regex-groups": "0.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "spa-ssi": "0.0.28"
  },
  "exports": {
    ".": "./be-dispatching.js",
    "./be-dispatching.js": "./be-dispatching.js",
    "./def.js": "./def.js",
    "./emc.json": "./emc.json",
    "./📡.json": "./📡.json"
  },
  "files": [
    "*.js",
    "*.json",
    "types.d.ts"
  ],
  "types": "./types/be-dispatching/types.d.ts",
  "scripts": {
    "build": "node emc.mjs > emc.json && node 📡.mjs > 📡.json",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "author": "",
  "license": "MIT"
}
